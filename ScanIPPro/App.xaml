<Application x:Class="ScanIPPro.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:ScanIPPro.Converters"
             >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Конвертеры -->
            <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
            <converters:StatusToIconConverter x:Key="StatusToIconConverter"/>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:OnlineCountConverter x:Key="OnlineCountConverter"/>
            <converters:RoundtripTimeConverter x:Key="RoundtripTimeConverter"/>
            <converters:BoolToThemeConverter x:Key="BoolToThemeConverter"/>
            <converters:PortStatusToColorConverter x:Key="PortStatusToColorConverter"/>

            <!-- Стиль для кнопок -->
            <Style x:Key="AccentButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource SystemAccentColor}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>