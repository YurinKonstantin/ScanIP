<Window x:Class="ScanIPPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:ScanIPPro.Models"
        Title="ScanIP Pro">

    <NavigationView x:Name="NavView"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="True"
                    PaneDisplayMode="LeftCompact"
                    SelectionChanged="OnNavSelectionChanged"
                    ItemInvoked="OnNavItemInvoked"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">

        <NavigationView.MenuItems>
            <NavigationViewItem x:Name="NavDevicesItem" Tag="scanner" Icon="Globe"/>
        </NavigationView.MenuItems>

        <Grid>
            <Grid x:Name="ScannerPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
                    <TextBlock x:Uid="AppTitle"
                               Style="{StaticResource TitleTextBlockStyle}"
                               Margin="12,8,0,0"/>
                </Grid>

                <Border Grid.Row="1" Padding="12,8" BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="IpRangeTextBox" x:Uid="IpRangeTextBox"
                                     Width="360" Height="36" VerticalAlignment="Center"/>
                            <Button x:Name="ScanButton" x:Uid="ScanButton"
                                    Click="OnScanClicked" Style="{StaticResource AccentButtonStyle}"
                                    Height="36" MinWidth="100"/>
                            <Button x:Uid="ClearButton" Click="OnClearClicked" Height="36" MinWidth="80"/>
                            <Button x:Uid="ExportButton" Click="OnExportClicked" Height="36" MinWidth="90"/>
                            <Button x:Name="ThemeToggleButton" Click="OnThemeToggleClicked"
                                    Height="36" Width="40" ToolTipService.ToolTip="Theme">
                                <FontIcon Glyph="&#xE706;" FontSize="14"/>
                            </Button>
                        </StackPanel>
                        <ProgressBar x:Name="ScanProgressBar" Height="4" Minimum="0" Maximum="100"
                                     Visibility="Collapsed"/>
                        <TextBlock x:Name="StatusTextBlock" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Padding="12,6" BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" x:Uid="SearchBox"
                                 TextChanged="OnSearchTextChanged" VerticalAlignment="Center"/>
                        <ComboBox x:Name="FilterComboBox" Grid.Column="1" Width="160"
                                  SelectionChanged="OnFilterChanged" VerticalAlignment="Center">
                            <ComboBoxItem x:Uid="FilterComboBoxItemAll" Tag="all"/>
                            <ComboBoxItem x:Uid="FilterComboBoxItemOnline" Tag="online"/>
                            <ComboBoxItem x:Uid="FilterComboBoxItemOffline" Tag="offline"/>
                        </ComboBox>
                        <Button x:Uid="ClearFilterButton" Grid.Column="2"
                                Click="OnClearFilterClicked" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Padding="12,4,12,0" ColumnSpacing="8" Background="{ThemeResource LayerFillColorAltBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ColumnIpHeader" Grid.Column="1" Style="{StaticResource ColumnHeaderTextStyle}"/>
                    <TextBlock x:Name="ColumnHostHeader" Grid.Column="2" Style="{StaticResource ColumnHeaderTextStyle}"/>
                    <TextBlock x:Name="ColumnMacHeader" Grid.Column="3" Style="{StaticResource ColumnHeaderTextStyle}"/>
                    <TextBlock x:Name="ColumnVendorHeader" Grid.Column="4" Style="{StaticResource ColumnHeaderTextStyle}"/>
                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                        <TextBlock x:Name="ColumnPortsHeader" Style="{StaticResource ColumnHeaderTextStyle}"/>
                        <TextBlock x:Name="ColumnRttHeader" Style="{StaticResource ColumnHeaderTextStyle}"/>
                        <TextBlock x:Name="ColumnStatusHeader" Style="{StaticResource ColumnHeaderTextStyle}"/>
                    </StackPanel>
                </Grid>

                <Pivot x:Name="MainPivot" Grid.Row="4" Margin="0">
                    <PivotItem x:Uid="PivotDevices">
                        <Grid>
                            <ListView x:Name="ResultsListView" SelectionMode="Single"
                                      RightTapped="OnDeviceRightTapped"
                                      IsItemClickEnabled="True"
                                      ItemClick="OnDeviceClicked">
                                <ListView.ItemContainerTransitions>
                                    <TransitionCollection>
                                        <EntranceThemeTransition IsStaggeringEnabled="True"/>
                                    </TransitionCollection>
                                </ListView.ItemContainerTransitions>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ScanResult">
                                        <Border Padding="4,8" BorderThickness="0,0,0,1"
                                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center"
                                                         Fill="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding IPAddress}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding DisplayHostName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding MACAddress}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Vendor}" FontSize="12" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding OpenPorts}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding RoundtripTime, Converter={StaticResource RoundtripTimeConverter}}" FontSize="12"
                                                               Visibility="{Binding IsOnline, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    <TextBlock Text="{Binding DisplayStatus}" FontWeight="SemiBold" FontSize="12"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="EmptyDevicesText"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </PivotItem>

                    <PivotItem x:Uid="PivotPorts">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="SelectedDeviceInfo" Grid.Row="0" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Grid Grid.Row="1" ColumnSpacing="8" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="ColumnPortStatusHeader" Style="{StaticResource ColumnHeaderTextStyle}"/>
                                <TextBlock x:Name="ColumnPortHeader" Grid.Column="1" Style="{StaticResource ColumnHeaderTextStyle}"/>
                                <TextBlock x:Name="ColumnProtocolHeader" Grid.Column="2" Style="{StaticResource ColumnHeaderTextStyle}"/>
                                <TextBlock x:Name="ColumnServiceHeader" Grid.Column="3" Style="{StaticResource ColumnHeaderTextStyle}"/>
                                <TextBlock x:Name="ColumnBannerHeader" Grid.Column="4" Style="{StaticResource ColumnHeaderTextStyle}"/>
                            </Grid>
                            <Grid Grid.Row="2">
                                <ListView x:Name="PortsListView">
                                    <ListView.ItemContainerTransitions>
                                        <TransitionCollection>
                                            <EntranceThemeTransition IsStaggeringEnabled="True"/>
                                        </TransitionCollection>
                                    </ListView.ItemContainerTransitions>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:PortScanResult">
                                            <Border Padding="4,6" BorderThickness="0,0,0,1"
                                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left"
                                                            Background="{Binding Status, Converter={StaticResource PortStatusToColorConverter}}">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="White"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Port}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Protocol}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Service}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Banner}" TextTrimming="CharacterEllipsis" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock x:Name="EmptyPortsText"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </PivotItem>

                    <PivotItem x:Uid="PivotPing">
                        <Grid RowSpacing="12" Padding="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="8">
                                <TextBox x:Name="PingTargetBox" x:Uid="PingTargetBox"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="PingStartButton" x:Uid="PingStartButton"
                                            Click="OnPingStartClicked" Style="{StaticResource AccentButtonStyle}"
                                            MinWidth="88"/>
                                    <Button x:Name="PingStopButton" x:Uid="PingStopButton"
                                            Click="OnPingStopClicked" IsEnabled="False"
                                            MinWidth="88"/>
                                </StackPanel>
                            </StackPanel>
                            <ListView x:Name="PingResultsList" Grid.Row="1">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:PingSample">
                                        <Grid ColumnSpacing="12" Padding="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Timestamp}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding RoundtripTime}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Status}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </PivotItem>

                    <PivotItem x:Uid="PivotTraceroute">
                        <Grid RowSpacing="12" Padding="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="8">
                                <TextBox x:Name="TracerouteTargetBox" x:Uid="TracerouteTargetBox"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="TracerouteStartButton" x:Uid="TracerouteStartButton"
                                            Click="OnTracerouteStartClicked" Style="{StaticResource AccentButtonStyle}"
                                            MinWidth="88"/>
                                    <Button x:Name="TracerouteStopButton" x:Uid="TracerouteStopButton"
                                            Click="OnTracerouteStopClicked" IsEnabled="False"
                                            MinWidth="88"/>
                                </StackPanel>
                            </StackPanel>
                            <ListView x:Name="TracerouteResultsList" Grid.Row="1">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:TracerouteHop">
                                        <Grid ColumnSpacing="12" Padding="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Hop}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Address}" FontFamily="Consolas"/>
                                            <TextBlock Grid.Column="2" Text="{Binding HostName}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="3" Text="{Binding RoundtripTime}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </PivotItem>
                </Pivot>

                <Border Grid.Row="5" Padding="12,8" BorderThickness="0,1,0,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusTextBlockBottom"/>
                        <TextBlock x:Name="DeviceCountTextBlock" Grid.Column="1"/>
                    </Grid>
                </Border>
            </Grid>

            <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" Padding="24">
                <StackPanel Spacing="16" MaxWidth="480">
                    <TextBlock x:Name="SettingsTitleText" Style="{StaticResource TitleTextBlockStyle}"/>
                    <ComboBox x:Name="LanguageComboBox" HorizontalAlignment="Stretch"
                              SelectionChanged="OnLanguageChanged"/>
                    <ComboBox x:Name="ThemeComboBox" HorizontalAlignment="Stretch"
                              SelectionChanged="OnThemeSettingChanged">
                        <ComboBoxItem x:Name="ThemeSystemItem" Tag="System"/>
                        <ComboBoxItem x:Name="ThemeLightItem" Tag="Light"/>
                        <ComboBoxItem x:Name="ThemeDarkItem" Tag="Dark"/>
                    </ComboBox>
                    <NumberBox x:Name="PingTimeoutBox"
                               Minimum="500" Maximum="10000" SpinButtonPlacementMode="Inline"/>
                    <NumberBox x:Name="ConcurrencyBox"
                               Minimum="1" Maximum="100" SpinButtonPlacementMode="Inline"/>
                    <ToggleSwitch x:Name="OnlineOnlyToggle"/>
                    <Button x:Name="SettingsSaveButton" Click="OnSettingsSaveClicked"
                            Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </NavigationView>
</Window>
