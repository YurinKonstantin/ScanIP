<Window x:Class="ScanIPPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:ScanIPPro.Models"
        Title="ScanIP Pro" 
        >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- Панель управления -->
            <RowDefinition Height="Auto"/>
            <!-- Поиск и фильтрация -->
            <RowDefinition Height="*"/>
            <!-- Вкладки -->
            <RowDefinition Height="Auto"/>
            <!-- Строка состояния -->
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid x:Name="AppTitleBar" 
              Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" 
              Height="40">
            <TextBlock Text="⚡ ScanIP Pro" 
                       Style="{StaticResource TitleTextBlockStyle}" 
                       Margin="12,8,0,0"
                       Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
        </Grid>

        <!-- Панель управления -->
        <Border Grid.Row="1" 
                Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                Padding="12,8"
                BorderBrush="{ThemeResource SystemControlForegroundChromeHighBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="IpRangeTextBox" 
                         PlaceholderText="Введите IP или диапазон (192.168.1.1-254)"
                         Width="350" Height="36" 
                         VerticalAlignment="Center"
                         Text="192.168.1.1-254"/>
                <Button x:Name="ScanButton" 
                        Content="Сканировать" 
                        Click="OnScanClicked"
                        Style="{StaticResource AccentButtonStyle}"
                        Height="36" Width="100"/>
                <Button Content="Очистить" 
                        Click="OnClearClicked" 
                        Height="36" Width="80"/>
                <Button Content="📥 Экспорт" 
                        Click="OnExportClicked"
                        Height="36" Width="100"/>
                <Button x:Name="ThemeToggleButton" 
                        Content="🌓" 
                        Click="OnThemeToggleClicked"
                        Height="36" Width="48"
                        ToolTipService.ToolTip="Переключить тему"/>
                <TextBlock x:Name="StatusTextBlock" 
                           Text="Готов к сканированию" 
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
            </StackPanel>
        </Border>

        <!-- Панель поиска и фильтрации -->
        <Border Grid.Row="2" 
                Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{ThemeResource SystemControlForegroundChromeHighBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox" 
                         Grid.Column="0"
                         PlaceholderText="Поиск по IP, имени, MAC или производителю..."
                         TextChanged="OnSearchTextChanged"
                         VerticalAlignment="Center"/>

                <ComboBox x:Name="FilterComboBox" 
                          Grid.Column="1"
                          SelectedIndex="0"
                          SelectionChanged="OnFilterChanged"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          Width="150">
                    <ComboBoxItem Content="Все устройства"/>
                    <ComboBoxItem Content="Только онлайн"/>
                    <ComboBoxItem Content="Только офлайн"/>
                </ComboBox>

                <Button x:Name="ClearFilterButton" 
                        Grid.Column="2"
                        Content="✕ Очистить"
                        Click="OnClearFilterClicked"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Вкладки -->
        <Pivot x:Name="MainPivot" Grid.Row="3" Margin="0" SelectedIndex="0" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
            <!-- Вкладка Устройства -->
            <PivotItem Header="📡 Устройства">
                <ListView x:Name="ResultsListView" Margin="12,8,12,0"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ScanResult">
                            <Border BorderThickness="0,0,0,1" 
                                    BorderBrush="{ThemeResource SystemControlBackgroundListLowBrush}"
                                    Padding="4,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Индикатор статуса -->
                                    <Ellipse Grid.Column="0" 
                                             Width="14" Height="14"
                                             Fill="{Binding Status, 
                                                    Converter={StaticResource StatusToColorConverter}}"
                                             VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding IPAddress}" 
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="2" 
                                               Text="{Binding HostName}" 
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="3" 
                                               Text="{Binding MACAddress}" 
                                               FontFamily="Consolas" 
                                               FontSize="12"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="4" 
                                               Text="{Binding Vendor}" 
                                               FontSize="12"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="5" 
                                                Orientation="Horizontal" 
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Spacing="12">

                                        <TextBlock Text="{Binding OpenPorts}" 
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Text="{Binding RoundtripTime, 
                                                   Converter={StaticResource RoundtripTimeConverter}}" 
                                                   FontSize="12"
                                                   Visibility="{Binding IsOnline, 
                                                              Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                        <TextBlock Text="{Binding Status}" 
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Status, 
                                                              Converter={StaticResource StatusToColorConverter}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>

            <!-- Вкладка Порты -->
            <PivotItem Header="🔌 Порты">
                <Grid Margin="12,8,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Информация о выбранном устройстве -->
                    <Border Grid.Row="0" 
                            Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                            Padding="12,8"
                            CornerRadius="4"
                            Margin="0,0,0,8"
                            BorderBrush="{ThemeResource SystemControlForegroundChromeHighBrush}"
                            BorderThickness="1">
                        <TextBlock x:Name="SelectedDeviceInfo" 
                                   Text="Выберите устройство в списке для сканирования портов"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                    </Border>

                    <ListView x:Name="PortsListView" Grid.Row="1"> 
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PortScanResult">
                                <Border BorderThickness="0,0,0,1" 
                                        BorderBrush="{ThemeResource SystemControlBackgroundListLowBrush}"
                                        Padding="4,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Статус порта -->
                                        <Border Grid.Column="0" 
                                                Background="{Binding Status, 
                                                           Converter={StaticResource PortStatusToColorConverter}}"
                                                CornerRadius="4"
                                                Padding="8,2"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding StatusText}" 
                                                       FontSize="12"
                                                       Foreground="White"/>
                                        </Border>

                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding Port}" 
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2" 
                                                   Text="{Binding Protocol}" 
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="3" 
                                                   Text="{Binding Service}" 
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="4" 
                                                   Text="{Binding Banner}" 
                                                   TextTrimming="CharacterEllipsis"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
        </Pivot>

        <!-- Нижняя панель с информацией -->
        <Border Grid.Row="4" 
                Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                BorderBrush="{ThemeResource SystemControlForegroundChromeHighBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusTextBlockBottom" 
                           Text="Готов к сканированию"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>

                <TextBlock Grid.Column="1" 
                           x:Name="DeviceCountTextBlock"
                           Text="Устройств: 0 | Онлайн: 0 | Отображено: 0 | Портов: 0"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>